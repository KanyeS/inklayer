{
  "ConnectionStrings": {
    "Database": "Data Source=/data/inklayer.db"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Inklayer": {
    "Auth": {
      "Google": {
        "ClientId": "",
        "ClientSecret": ""
      },
      "BootstrapAdmins": "",
      "ExtensionRedirectUris": "",
      "InvitationLifetimeDays": 14,
      "AuthRequestsPerMinute": 30
    }
  }
}
