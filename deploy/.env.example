# Copy to .env and edit (all optional).
# INKLAYER_PORT=8080
# INKLAYER_IMAGE=ghcr.io/<owner>/inklayer-server:latest
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# People's own tracker accounts for issues: one OAuth app per tracker (docs/integrations.md#your-own-tracker-account).
# Callback URL: <server>/api/me/tracker-accounts/<github|gitlab|forgejo|linear|jira|azuredevops>/callback
# GitHub: Settings → Developer settings → OAuth Apps.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GitLab (gitlab.com, or set GITLAB_URL to your own): User settings → Applications, scope "api".
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_URL=https://gitlab.com
# Codeberg (or set FORGEJO_URL to your own Forgejo or Gitea): Settings → Applications → OAuth2 applications.
# FORGEJO_CLIENT_ID=
# FORGEJO_CLIENT_SECRET=
# FORGEJO_URL=https://codeberg.org
# Linear: Settings → API → OAuth applications.
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# Jira Cloud: an OAuth 2.0 (3LO) app at developer.atlassian.com.
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=
# Azure DevOps: a Microsoft Entra ID app registration with the Azure DevOps "user_impersonation" permission.
# AZURE_DEVOPS_CLIENT_ID=
# AZURE_DEVOPS_CLIENT_SECRET=
# AZURE_DEVOPS_TENANT_ID=organizations
# Or a certificate instead of the secret: a PEM with the certificate and private key (or a .pfx) in ./certs/.
# AZURE_DEVOPS_CERTIFICATE_PATH=/certs/azuredevops.pem
# AZURE_DEVOPS_CERTIFICATE_PASSWORD=

# Full-page screenshots and videos (see docs/integrations.md). Without a bucket they go in /data/media on the server,
# which isn't backed up. The bucket can be the backups' one (files go under media/); the access key needs the same
# permissions on it as Litestream's (iam-policy.json). Defaults to AWS_REGION and the AWS_* key above.
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=
# MEDIA_AWS_ACCESS_KEY_ID=
# MEDIA_AWS_SECRET_ACCESS_KEY=
# Single sign-on through any OpenID Connect provider (JumpCloud, Okta, Entra ID, ...). Redirect URI: <server>/auth/callback/<OIDC_ID>
# OIDC_ID=jumpcloud
# OIDC_DISPLAY_NAME=JumpCloud
# OIDC_AUTHORITY=https://oauth.id.jumpcloud.com/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_VERIFIED_DOMAINS=acme.com
# INKLAYER_BOOTSTRAP_ADMINS=you@example.com
# Only for an extension build with a different ID (the official one is always allowed):
# INKLAYER_EXTENSION_REDIRECT_URIS=
# Behind a reverse proxy (needed for HTTPS): the proxy's network. Without it the server sees the proxy's address for
# everyone and plain HTTP, and logs a warning saying so. 172.16.0.0/12 covers a proxy in Docker on the default networks.
# Then don't publish port 8080 to the internet (INKLAYER_PORT=127.0.0.1:8080): only the proxy should reach the server.
# INKLAYER_TRUSTED_PROXY_NETWORK=172.16.0.0/12
# Plain-HTTP local trial only. Never with a proxy: set the line above instead.
# INKLAYER_ALLOW_INSECURE_HTTP=true
# Only answer requests from these networks, e.g. the company VPN (addresses or CIDR ranges, comma-separated).
# The starting list: administrators can change it later under Admin → Network access.
# INKLAYER_ALLOWED_NETWORKS=10.8.0.0/16, 203.0.113.7
# Recovery if administrators lock themselves out: turns the restriction off until removed.
# INKLAYER_NETWORK_RESTRICTION_DISABLED=true

# Optional: turn major features off when the server starts. These are starting values: administrators can turn them
# on or off later under Admin → Features, and their choice wins. Page comments are always on.
# INKLAYER_FEATURE_DOCS=false          # the docs knowledge base, graph and doc links
# INKLAYER_FEATURE_LIVE_CURSORS=false  # live cursors on web pages and in docs
# INKLAYER_FEATURE_MCP=false           # AI assistants (MCP endpoint, app sign-in)
# INKLAYER_FEATURE_BUG_CONTEXT=false   # screenshots and page details with comments
# INKLAYER_FEATURE_ISSUE_TRACKERS=false # GitHub, Jira and Linear issues from comments
# INKLAYER_FEATURE_SHARING=false       # read-only share links and public docs

# Optional: email notifications. Organisations choose to send them (Integrations tab); people can opt out in Settings.
# Amazon SES works: use its SMTP endpoint and SMTP credentials, and a verified sender.
# INKLAYER_SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# INKLAYER_SMTP_PORT=587
# INKLAYER_SMTP_USERNAME=
# INKLAYER_SMTP_PASSWORD=
# INKLAYER_SMTP_FROM=Inklayer <inklayer@example.com>
# The address people use for Inklayer, for links in emails sent in the background.
# INKLAYER_PUBLIC_URL=https://inklayer.example.com
