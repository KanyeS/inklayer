# Copy to .env and edit (all optional).
# INKLAYER_PORT=8080
# INKLAYER_IMAGE=ghcr.io/<owner>/inklayer-server:latest
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Single sign-on through any OpenID Connect provider (JumpCloud, Okta, Entra ID, ...). Redirect URI: <server>/auth/callback/<OIDC_ID>
# OIDC_ID=jumpcloud
# OIDC_DISPLAY_NAME=JumpCloud
# OIDC_AUTHORITY=https://oauth.id.jumpcloud.com/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_VERIFIED_DOMAINS=acme.com
# INKLAYER_BOOTSTRAP_ADMINS=you@example.com
# INKLAYER_EXTENSION_REDIRECT_URIS=
# INKLAYER_ALLOW_INSECURE_HTTP=true
# Only answer requests from these networks, e.g. the company VPN (addresses or CIDR ranges, comma-separated).
# The starting list: administrators can change it later under Admin → Network access.
# INKLAYER_ALLOWED_NETWORKS=10.8.0.0/16, 203.0.113.7
# Recovery if administrators lock themselves out: turns the restriction off until removed.
# INKLAYER_NETWORK_RESTRICTION_DISABLED=true

# Optional: turn major features off when the server starts. These are starting values: administrators can turn them
# on or off later under Admin → Features, and their choice wins. Page comments are always on.
# INKLAYER_FEATURE_DOCS=false          # the docs knowledge base, graph and doc links
# INKLAYER_FEATURE_LIVE_CURSORS=false  # live cursors on web pages and in docs
# INKLAYER_FEATURE_MCP=false           # AI assistants (MCP endpoint, app sign-in)
# INKLAYER_FEATURE_BUG_CONTEXT=false   # screenshots and page details with comments
# INKLAYER_FEATURE_ISSUE_TRACKERS=false # GitHub, Jira and Linear issues from comments
# INKLAYER_FEATURE_SHARING=false       # read-only share links and public docs

# Optional: email notifications. Organisations choose to send them (Integrations tab); people can opt out in Settings.
# Amazon SES works: use its SMTP endpoint and SMTP credentials, and a verified sender.
# INKLAYER_SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# INKLAYER_SMTP_PORT=587
# INKLAYER_SMTP_USERNAME=
# INKLAYER_SMTP_PASSWORD=
# INKLAYER_SMTP_FROM=Inklayer <inklayer@example.com>
# The address people use for Inklayer, for links in emails sent in the background.
# INKLAYER_PUBLIC_URL=https://inklayer.example.com
