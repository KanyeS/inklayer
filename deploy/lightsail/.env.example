# Copy to .env on the VM:  cp .env.example .env && chmod 600 .env

# Image published by the Release workflow (lowercase owner/repo).
INKLAYER_IMAGE=ghcr.io/OWNER/inklayer-server:latest

# Public hostname whose DNS A record points at the Lightsail static IP.
INKLAYER_DOMAIN=inklayer.example.com
# Let's Encrypt registration and expiry notices.
ACME_EMAIL=admin@example.com

# Sign-in: configure Google, an OpenID Connect provider, or both. With both, people choose on the sign-in page.
# Google (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorised redirect URI: https://<INKLAYER_DOMAIN>/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OpenID Connect provider such as JumpCloud, Okta or Entra ID (see docs/sso-oidc.md).
# Redirect URI to register at the provider: https://<INKLAYER_DOMAIN>/auth/callback/<OIDC_ID>
# OIDC_ID=jumpcloud
# OIDC_DISPLAY_NAME=JumpCloud
# OIDC_AUTHORITY=https://oauth.id.jumpcloud.com/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Email domains the provider is the authority for (comma-separated). Their users are trusted and can join organisations by domain.
# OIDC_VERIFIED_DOMAINS=acme.com
# Emails that become instance administrators on sign-in (comma-separated). Also the recovery path if admins are locked out.
INKLAYER_BOOTSTRAP_ADMINS=you@example.com
# Browser extension sign-in address(es), comma-separated, as shown in the extension popup (set once it's installed):
#   Chrome: https://<extension-id>.chromiumapp.org/   Firefox: https://<hash>.extensions.allizom.org/
INKLAYER_EXTENSION_REDIRECT_URIS=

# S3 backup target for Litestream.
LITESTREAM_BUCKET=your-inklayer-backups
AWS_REGION=us-east-1
# How Litestream signs in to the bucket (see docs/deploy-aws-lightsail.md):
#   keys      an S3 bucket plus an IAM user's access key, limited to that bucket (default)
#   instance  a Lightsail bucket with this instance attached ("resource access"); no keys to store
LITESTREAM_AUTH=keys
# Only for LITESTREAM_AUTH=keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Loads the compose override for the chosen LITESTREAM_AUTH. Leave as is.
COMPOSE_FILE=docker-compose.yml:litestream-auth.${LITESTREAM_AUTH}.yml

# Optional
# OTEL_EXPORTER_OTLP_ENDPOINT=
