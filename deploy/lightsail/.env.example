# Copy to .env on the VM:  cp .env.example .env && chmod 600 .env

# Image published by the Release workflow (lowercase owner/repo).
INKLAYER_IMAGE=ghcr.io/OWNER/inklayer-server:latest

# Public hostname whose DNS A record points at the Lightsail static IP.
INKLAYER_DOMAIN=inklayer.example.com
# Let's Encrypt registration and expiry notices.
ACME_EMAIL=admin@example.com

# Sign-in: configure Google, an OpenID Connect provider, or both. With both, people choose on the sign-in page.
# Google (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorised redirect URI: https://<INKLAYER_DOMAIN>/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OpenID Connect provider such as JumpCloud, Okta or Entra ID (see docs/sso-oidc.md).
# Redirect URI to register at the provider: https://<INKLAYER_DOMAIN>/auth/callback/<OIDC_ID>
# OIDC_ID=jumpcloud
# OIDC_DISPLAY_NAME=JumpCloud
# OIDC_AUTHORITY=https://oauth.id.jumpcloud.com/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Email domains the provider is the authority for (comma-separated). Their users are trusted and can join organisations by domain.
# OIDC_VERIFIED_DOMAINS=acme.com
# Emails that become instance administrators on sign-in (comma-separated). Also the recovery path if admins are locked out.
INKLAYER_BOOTSTRAP_ADMINS=you@example.com
# Optional: people create issues, reply and close them as their own tracker accounts. One OAuth app per tracker
# (step by step: docs/integrations.md#your-own-tracker-account). Callback URL for each:
#   https://<INKLAYER_DOMAIN>/api/me/tracker-accounts/<github|gitlab|forgejo|linear|jira|azuredevops>/callback
# GitHub: Settings → Developer settings → OAuth Apps → New OAuth App.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitLab (gitlab.com, or set GITLAB_URL to your own): User settings → Applications, scope "api".
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_URL=https://gitlab.com
# Codeberg (or set FORGEJO_URL to your own Forgejo or Gitea): Settings → Applications → OAuth2 applications.
# FORGEJO_CLIENT_ID=
# FORGEJO_CLIENT_SECRET=
# FORGEJO_URL=https://codeberg.org
# Linear: Settings → API → OAuth applications.
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# Jira Cloud: an OAuth 2.0 (3LO) app at developer.atlassian.com.
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=
# Azure DevOps: a Microsoft Entra ID app registration with the Azure DevOps "user_impersonation" permission.
# AZURE_DEVOPS_CLIENT_ID=
# AZURE_DEVOPS_CLIENT_SECRET=
# AZURE_DEVOPS_TENANT_ID=organizations
# Or a certificate instead of the secret: a PEM with the certificate and private key (or a .pfx) in ./certs/.
# AZURE_DEVOPS_CERTIFICATE_PATH=/certs/azuredevops.pem
# AZURE_DEVOPS_CERTIFICATE_PASSWORD=

# Full-page screenshots and videos (see docs/integrations.md). Without a bucket they go in /data/media on the server,
# which isn't backed up. The bucket can be the backups' one (files go under media/); the access key needs the same
# permissions on it as Litestream's (iam-policy.json). Defaults to AWS_REGION and the AWS_* key above.
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=
# MEDIA_AWS_ACCESS_KEY_ID=
# MEDIA_AWS_SECRET_ACCESS_KEY=
# The official browser extension (Chrome Web Store and Firefox) is always allowed to sign in. Only for a build with a
# different extension ID (a fork), add its sign-in address(es), comma-separated:
#   Chrome: https://<extension-id>.chromiumapp.org/   Firefox: https://<hash>.extensions.allizom.org/
INKLAYER_EXTENSION_REDIRECT_URIS=

# Optional: only answer requests from these networks, e.g. the company VPN's exit addresses (addresses or CIDR ranges,
# comma-separated). The starting list: administrators can change it later under Admin → Network access.
# INKLAYER_ALLOWED_NETWORKS=10.8.0.0/16, 203.0.113.7
# Recovery if administrators lock themselves out: turns the restriction off until removed.
# INKLAYER_NETWORK_RESTRICTION_DISABLED=true

# Optional: turn major features off when the server starts. These are starting values: administrators can turn them
# on or off later under Admin → Features, and their choice wins. Page comments are always on.
# INKLAYER_FEATURE_DOCS=false          # the docs knowledge base, graph and doc links
# INKLAYER_FEATURE_LIVE_CURSORS=false  # live cursors on web pages and in docs
# INKLAYER_FEATURE_MCP=false           # AI assistants (MCP endpoint, app sign-in)
# INKLAYER_FEATURE_BUG_CONTEXT=false   # screenshots and page details with comments
# INKLAYER_FEATURE_ISSUE_TRACKERS=false # GitHub, Jira and Linear issues from comments
# INKLAYER_FEATURE_SHARING=false       # read-only share links and public docs

# Optional: email notifications. Organisations choose to send them (Integrations tab); people can opt out in Settings.
# Amazon SES works: use its SMTP endpoint and SMTP credentials, and a verified sender.
# INKLAYER_SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# INKLAYER_SMTP_PORT=587
# INKLAYER_SMTP_USERNAME=
# INKLAYER_SMTP_PASSWORD=
# INKLAYER_SMTP_FROM=Inklayer <inklayer@example.com>

# S3 backup target for Litestream.
LITESTREAM_BUCKET=your-inklayer-backups
AWS_REGION=us-east-1
# How Litestream signs in to the bucket (see docs/deploy-aws-lightsail.md):
#   keys      an S3 bucket plus an IAM user's access key, limited to that bucket (default)
#   instance  a Lightsail bucket with this instance attached ("resource access"); no keys to store
LITESTREAM_AUTH=keys
# Only for LITESTREAM_AUTH=keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Loads the compose override for the chosen LITESTREAM_AUTH. Leave as is.
COMPOSE_FILE=docker-compose.yml:litestream-auth.${LITESTREAM_AUTH}.yml

# Optional
# OTEL_EXPORTER_OTLP_ENDPOINT=
