{
  "name": "inklayer-client",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @inklayer/extension && npm run build -w @inklayer/viewer",
    "test": "vitest run",
    "typecheck": "tsc -p packages/overlay && tsc -p packages/ui && tsc -p apps/extension && tsc -p apps/viewer && tsc -p apps/site",
    "licenses": "license-checker-rseidelsohn --excludePrivatePackages --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;BlueOak-1.0.0;CC0-1.0;MPL-2.0;CC-BY-3.0;OFL-1.1\" --excludePackages \"fetch-cookie@2.2.0;argparse@3.0.4\" --summary",
    "build:site": "npm run build -w @inklayer/site"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/jsdom": "^30.0.0",
    "jsdom": "31.0.1",
    "license-checker-rseidelsohn": "5.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "type": "module"
}
